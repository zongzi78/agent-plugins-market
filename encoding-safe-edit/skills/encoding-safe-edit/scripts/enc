#!/usr/bin/env bash
# enc - encoding-safe-edit launcher (bash / Git Bash / Linux / macOS)
# ASCII-only by design: no non-ASCII characters, safe under any locale.
# User-facing text comes from enc.py; this launcher emits only English JSON when
# no usable runtime can be found.
# Zero-dependency bootstrap: probe a runtime via --version, then forward args to enc.py.
# Candidate order: uv -> python3 -> python.
#   enc selfcheck
#   enc --runtime auto|uv|python3|python <subcommand> [options...]
set -u
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
IMPL="$SELF_DIR/enc.py"
CANDIDATES="uv python3 python"

set_uv_cache() {
  local t
  t="${TMPDIR:-/tmp}"
  export UV_CACHE_DIR="$t/uv/cache"
  export UV_PYTHON_INSTALL_DIR="$t/uv/python"
  export UV_PYTHON_CACHE_DIR="$t/uv/pycache"
}

probe() {
  local n="$1" out code
  out=""; code=1
  case "$n" in
    uv)      set_uv_cache; out="$(uv run --no-project python --version 2>&1)"; code=$? ;;
    python3) out="$(python3 --version 2>&1)"; code=$? ;;
    python)  out="$(python --version 2>&1)"; code=$? ;;
    *)       return 1 ;;
  esac
  if [ "$code" -eq 0 ]; then
    case "$out" in
      *"Python "[0-9]*.[0-9]*) return 0 ;;
    esac
  fi
  return 1
}

run_with() {
  local n="$1"; shift
  case "$n" in
    uv)      exec uv run --no-project python "$IMPL" "$@" ;;
    python3) exec python3 "$IMPL" "$@" ;;
    python)  exec python "$IMPL" "$@" ;;
  esac
}

emit_no_runtime() {
  printf '{"ok":false,"error":"no usable Python runtime (probed: %s)","exitCode":1,"hint":"install uv or python3/python; refusing to run in an unverified environment"}\n' "$1"
}

RUNTIME="auto"
if [ "${1:-}" = "--runtime" ] && [ "$#" -ge 2 ]; then RUNTIME="$2"; shift 2; fi

case "$RUNTIME" in
  auto|uv|python3|python) ;;
  *) printf '{"ok":false,"error":"invalid --runtime value: %s","exitCode":1,"hint":"allowed: auto|uv|python3|python"}\n' "$RUNTIME"; exit 1 ;;
esac

if [ "${1:-}" = "selfcheck" ]; then
  items=""; sel=""
  for n in $CANDIDATES; do
    found=false; command -v "$n" >/dev/null 2>&1 && found=true
    if probe "$n"; then u=true; [ -z "$sel" ] && sel="$n"; else u=false; fi
    case "$n" in
      uv)      vout="$(uv run --no-project python --version 2>&1 || true)" ;;
      *)       vout="$("$n" --version 2>&1 || true)" ;;
    esac
    ver="$(printf '%s' "$vout" | sed -n 's/.*\(Python [0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1)"
    [ -n "$items" ] && items="$items,"
    items="$items{\"name\":\"$n\",\"found\":$found,\"usable\":$u,\"version\":\"$ver\"}"
  done
  if [ -n "$sel" ]; then ok=true; seljson="\"$sel\""; else ok=false; seljson=null; fi
  printf '{"ok":%s,"launcher":"enc","implementation":"%s","candidates":[%s],"selected":%s}\n' "$ok" "$IMPL" "$items" "$seljson"
  [ -n "$sel" ] && exit 0 || exit 1
fi

ORDER="$CANDIDATES"
[ "$RUNTIME" != "auto" ] && ORDER="$RUNTIME"

for n in $ORDER; do
  if probe "$n"; then run_with "$n" "$@"; fi
done

emit_no_runtime "$ORDER"
exit 1
